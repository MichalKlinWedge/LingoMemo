{
  "name": "lingomemo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:build",
    "check:build": "npm run build --workspace apps/web",
    "web": "node scripts/sync-env.mjs && npm run dev --workspace apps/web",
    "web:local": "node scripts/sync-env.mjs --local && npm run dev --workspace apps/web",
    "env:sync": "node scripts/sync-env.mjs",
    "mobile": "node scripts/sync-env.mjs --mobile && npm run start --workspace apps/mobile",
    "ota": "npm run ota --workspace apps/mobile",
    "ota:dzieci": "npm run ota:dzieci --workspace apps/mobile",
    "apk": "npm run apk --workspace apps/mobile",
    "apk:dzieci": "npm run apk:dzieci --workspace apps/mobile",
    "supabase": "npx --yes supabase@2.122.0",
    "db:start": "npx --yes supabase@2.122.0 start",
    "db:stop": "npx --yes supabase@2.122.0 stop",
    "db:reset": "npx --yes supabase@2.122.0 db reset",
    "db:push": "npx --yes supabase@2.122.0 db push",
    "test:db": "npx --yes supabase@2.122.0 test db",
    "gen": "npm run gen --workspace packages/db",
    "gen:fsrs": "node scripts/fsrs-fixtures.mjs",
    "gen:icons": "node scripts/icons.mjs",
    "gen:og": "node scripts/og-image.mjs",
    "seed:dev": "npm run seed --workspace tools/seed-dev --",
    "import:lesson": "npm run import --workspace tools/import-lesson --"
  },
  "engines": {
    "node": ">=22"
  }
}
