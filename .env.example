# Skopiuj do .env.local (w katalogu głównym) i uzupełnij. .env.local nigdy nie trafia do repozytorium.
#
# Jeden plik w katalogu głównym jest źródłem prawdy — `node scripts/sync-env.mjs` przepisuje z niego
# apps/web/.env.local, bo Next czyta zmienne tylko z katalogu swojej aplikacji. Na produkcji
# odpowiednikiem tego pliku są zmienne projektu w panelu Vercel.
#
# Przedrostek NEXT_PUBLIC_ = wartość trafia do przeglądarki. Wszystko bez niego zostaje na serwerze.

# --- Supabase (publiczne; dostępu do danych pilnuje RLS) ---
# Adres projektu. Lokalnie ustawia go `npm run web:local` z `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
# Klucz publishable (dawniej anon).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (sekret; TYLKO lokalnie, nigdy w Vercelu i nigdy w aplikacji) ---
# Omija RLS. Używają go wyłącznie skrypty z tools/ (seed, nadanie pierwszego admina),
# które odmawiają pracy, gdy adres nie jest localhostem.
SUPABASE_SERVICE_ROLE_KEY=

# --- Adres aplikacji ---
# Do budowania linków z zaproszeniem. Lokalnie: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
