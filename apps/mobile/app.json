{
  "expo": {
    "name": "LingoMemo",
    "slug": "lingomemo",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/ikona.png",
    "scheme": "lingomemo",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fffaf2",
    "android": {
      "package": "pl.lingomemo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/ikona-maskowalna.png",
        "backgroundColor": "#fffaf2"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-image"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "url": "https://u.expo.dev/ebf05bd8-73e6-4ef7-b5d5-188aa171241a"
    },
    "owner": "klin.michal",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ebf05bd8-73e6-4ef7-b5d5-188aa171241a"
      }
    },
    "ios": {}
  }
